# --- Génération des leçons à partir des cours déposés -----------------------
# Sans cette clé, Lexio découpe les cours avec son analyseur local (qualité moindre).
ANTHROPIC_API_KEY=sk-ant-...
# Modèle utilisé. Par défaut Claude Haiku 4.5, le meilleur rapport qualité/prix ici.
LEXIO_MODEL=claude-haiku-4-5

# --- Comptes, synchronisation multi-appareils, sauvegarde -------------------
# Sans ces clés, la progression reste stockée dans le navigateur de l'élève.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Abonnement -------------------------------------------------------------
# Sans ces clés, l'accès reste ouvert et la page d'abonnement l'indique.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...          # formule mensuelle
STRIPE_PRICE_ID_ANNUAL=price_...   # formule annuelle
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Divers -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://lexio-roan.vercel.app

# Secret partagé avec Vercel Cron pour protéger /api/cron/rappel. Sans cette
# clé, la route refuse tout appel (fail closed) : génère une valeur aléatoire
# (ex. openssl rand -hex 32) et pose-la ici et dans les variables d'env Vercel.
# Vercel ajoute alors automatiquement l'en-tête Authorization à ses appels
# planifiés — rien d'autre à configurer côté vercel.json.
CRON_SECRET=

# --- Notification email des suggestions envoyées via /plus ------------------
# Sans cette clé, les suggestions restent enregistrées en base (table
# `feedback`) mais aucun email n'est envoyé.
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=contact@studijur.fr   # doit être un expéditeur vérifié dans Brevo
FEEDBACK_NOTIFY_EMAIL=emiletaraud942@gmail.com
